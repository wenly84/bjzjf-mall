# .env 配置文件

# 版本号
# 用于标记当前应用的版本，便于管理和升级
ZJFSHOP_VERSION=v1.3.4

# 后端接口 - 正式环境
# 通过 process.env.NODE_ENV 判断非开发环境时使用此接口
ZJFSHOP_BASE_URL=https://api.hansi.site

# 后端接口 - 开发环境
# 当 process.env.NODE_ENV = 'development' 时，使用此接口地址

#ZJFSHOP_DEV_BASE_URL=http://127.0.0.1:1984
ZJFSHOP_DEV_BASE_URL = https://api.hansi.site

# 后端接口路径前缀
# 一般不建议修改此值，后端服务接口统一使用该前缀
ZJFSHOP_API_PATH=/app-api

# 后端 WebSocket 接口路径前缀
# 用于 WebSocket 通信的接口地址前缀
ZJFSHOP_WEBSOCKET_PATH=/infra/ws

# 开发环境运行端口
# 该端口仅用于开发环境，本地运行时使用
ZJFSHOP_DEV_PORT=2024

#ZJFSHOP_STATIC_URL=https://testfiles.hansi.site
JFSHOP_STATIC_URL=https://www.hansi.site

# 是否开启直播
# 1 表示开启直播，0 表示关闭直播
# 请注意：小程序官方后台未审核开通直播权限时请勿开启直播
ZJFSHOP_MPLIVE_ON=0

# 租户ID
# 用于多租户架构，默认值为1,测试租户128
ZJFSHOP_TENANT_ID=1

